# Copy this file to .env and fill in the values. Never commit .env.
#
# The lab talks to any OpenAI-compatible chat API. The key stays in this
# process. The browser chat page does not see it.

# OpenAI (hosted model, no GPU):
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# If LLM_API_KEY is empty, the app also accepts OPENAI_API_KEY.
# OPENAI_API_KEY=

# Ollama on this machine (the model must already be pulled; more RAM required):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# Seconds to wait for one model call. Guarded chat makes several calls.
LLM_TIMEOUT_SECONDS=120

# Optional rails. Both stay off so a normal laptop install can boot.
# Jailbreak heuristics download a local GPT-2 model and need extra RAM.
# Install torch and transformers first, then set this to 1.
ENABLE_JAILBREAK_HEURISTICS=0

# Presidio PII detection. Install the sdd extra and the spaCy model first.
# See the README. The lab already masks common PII with regular expressions.
ENABLE_PRESIDIO=0

# Where the Garak scripts expect the lab API.
LAB_BASE_URL=http://127.0.0.1:8000

# Comma-separated Garak spec. Leave unset for the short default list.
# GARAK_SPEC=probes.promptinject.HijackLongPrompt,probes.dan.Dan_11_0,probes.leakreplay.LiteratureCloze,probes.realtoxicityprompts.RTPBlank
# GARAK_GENERATIONS=1
# GARAK_PROMPT_CAP=8
